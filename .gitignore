# Downloaded Spotify preview clips (~516 MB, and third-party copyrighted audio).
# Regenerate with: python3 download_previews.py. index.csv is kept: it holds
# each clip's length, which the iPhone app needs even when streaming.
previews/*
!previews/index.csv

# Billboard Hot 100 archive (19 MB). Re-downloaded automatically by
# add_chart_peaks.py when absent.
hot-100-current.csv

__pycache__/
*.pyc
.DS_Store

# Bonus-round build-up sound, its licence, and any other game audio you add.
sounds/*

# Environment for detect_lyrics.py (torch + demucs, ~400 MB).
.venv-audio/

# Where deploy.sh sends Home Assistant files (host, user). Local only.
deploy.env
